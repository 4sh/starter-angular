{
  "name": "angular-starter",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npm run build-info && npm run ui-kit:build && npm run docs:config && npm run docs:search && ng run demo:storybook",
    "serve": "npm run ui-kit:build && ng serve",
    "build": "npm run ui-kit:build && ng build",
    "lint": "ng lint --fix",
    "lint:check": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test ui-kit",
    "storybook": "npm run build-info && npm run ui-kit:build && npm run docs:config && npm run docs:search && ng run demo:storybook",
    "build-storybook": "npm run build-info && npm run ui-kit:build && npm run docs:config && npm run docs:search && ng run demo:build-storybook",
    "test-storybook:ci": "http-server storybook-static --port 6006 --silent & npx wait-on tcp:6006 && test-storybook --ci --config-dir storybook --url http://localhost:6006",
    "generate:assets": "node src/scripts/build-assets.js",
    "postinstall": "npm run tokens:build && npm run ui-kit:build && npm run docs:config",
    "ui-kit:build": "ng build ui-kit && npm run ui-kit:styles",
    "tokens:build": "node scripts/tokens.build.mjs",
    "build-info": "node scripts/build-info.mjs",
    "docs:config": "node scripts/docs.config.mjs && node scripts/component-vars.build.mjs",
    "docs:search": "node scripts/docs.search.mjs",
    "docs:config:check": "node scripts/docs.config.mjs --check && node scripts/component-vars.build.mjs --check && npm run components:check",
    "components:check": "node scripts/components.check.mjs",
    "ui-kit:styles": "sass projects/ui-kit/styles/index.scss dist/ui-kit/styles.css --load-path=projects/ui-kit/styles --no-source-map --style=compressed",
    "ui-kit:pack": "npm run ui-kit:build && node scripts/ui-kit-mcp-embed.build.mjs && npm pack ./dist/ui-kit",
    "schematics:assets": "node scripts/schematics-assets.build.mjs",
    "schematics:build": "node scripts/schematics-package.build.mjs",
    "schematics:pack": "npm run schematics:build && npm pack ./dist/ui-kit-schematics",
    "mcp:assets": "node scripts/mcp-assets.build.mjs",
    "mcp:bundle": "node scripts/mcp-bundle.build.mjs",
    "mcp:test": "vitest run --root projects/ui-kit-mcp"
  },
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "@fortawesome/fontawesome-free": "7.0.0",
    "gridaflex": "1.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.3",
    "@angular-devkit/core": "^22.1.3",
    "@angular-devkit/schematics": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@compodoc/compodoc": "1.1.26",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^1.4.8",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@storybook-community/storybook-dark-mode": "7.1.3",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/angular": "10.5.8",
    "@storybook/test-runner": "^0.24.4",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.2.0",
    "angular-eslint": "^22.1.0",
    "axe-playwright": "^2.2.2",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "minisearch": "^7.2.0",
    "ng-packagr": "^22.0.2",
    "prettier": "^3.9.6",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "storybook": "10.5.8",
    "style-dictionary": "5.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0",
    "zod": "^4.4.3"
  }
}
