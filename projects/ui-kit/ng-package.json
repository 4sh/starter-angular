{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ui-kit",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": ["./styles"]
  },
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "styles",
      "output": "styles"
    },
    {
      "glob": "NOTICE",
      "input": ".",
      "output": "."
    },
    {
      "glob": "collection.json",
      "input": ".",
      "output": "."
    },
    {
      "glob": "**/*.cjs",
      "input": "schematics",
      "output": "schematics"
    },
    {
      "glob": "schema-*.json",
      "input": "schematics",
      "output": "schematics"
    },
    {
      "glob": "README.fr.md",
      "input": ".",
      "output": "."
    }
  ]
}
