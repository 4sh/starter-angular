{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "1e1de97b-a744-405a-8b5a-0397bb3d01ce",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "demo": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "namedChunks": true,
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "aot": true,
              // No budgets here until FSHSP-128 — which is why FSHSP-127 (a
              // copied source tree cannot build) was found by an outside user.
              "budgets": [
                {
                  // `ng new` non-strict values: `demo` instantiates all 54
                  // components and lands at 1.24MB, so the strict 500kB/1MB
                  // would measure the showcase, not the kit.
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "5MB"
                },
                {
                  // Mirrors what the schematic writes for consumers
                  // (`ANY_COMPONENT_STYLE_FLOOR`) — `demo` must reflect a
                  // project AFTER `ng add`. Move both together.
                  "type": "anyComponentStyle",
                  "maximumError": "128kB"
                }
              ],
              "extractLicenses": true,
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            }
          },
          "options": {
            "assets": ["src/assets"],
            "index": "src/index.html",
            "browser": "src/main.ts",
            "outputPath": "dist/demo",
            "inlineStyleLanguage": "scss",
            "polyfills": [],
            "scripts": [],
            "styles": [
              "src/styles/main.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/ui-kit/styles",
                "src/styles",
                "src/assets",
                "node_modules"
              ],
              "sass": {
                "silenceDeprecations": ["global-builtin", "import"]
              }
            },
            "tsConfig": "tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "demo:build:development"
            },
            "production": {
              "buildTarget": "demo:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "storybook",
            "browserTarget": "demo:build",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "./assets/"
              }
            ],
            "styles": [
              "src/styles/main.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/ui-kit/styles", "src/styles", "src/assets", "node_modules"]
            },
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "storybook",
            "browserTarget": "demo:build",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "./assets/"
              }
            ],
            "styles": [
              "src/styles/main.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/ui-kit/styles", "src/styles", "src/assets", "node_modules"]
            },
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "outputDir": "storybook-static"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      },
      "prefix": "demo",
      "projectType": "application",
      "root": "",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "sourceRoot": "src"
    },
    "ui-kit": {
      "projectType": "library",
      "root": "projects/ui-kit",
      "sourceRoot": "projects/ui-kit/src",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui-kit/tsconfig.spec.json",
            // "include" globs relative to `sourceRoot` (projects/ui-kit/src),
            // but every entry point owns its own sibling src/ (forms/src,
            // ui-datepicker/src…) — the default "**/*.spec.ts" would only ever
            // scan the (unused) projects/ui-kit/src. "../" reaches the actual
            // entry points, one level up. Same root cause as tsconfig.spec.json's
            // "include" fix above this file's diff.
            "include": ["../**/*.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ui-kit/**/*.ts", "projects/ui-kit/**/*.html"],
            "eslintConfig": "projects/ui-kit/eslint.config.js"
          }
        }
      }
    }
  },
  "version": 1
}
