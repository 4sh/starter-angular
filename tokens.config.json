{
  "$schema": "./scripts/tokens.config.schema.json",
  "sourceRoot": "src/design-tokens",
  "header": "Generated by Style Dictionary — do not edit (run `npm run tokens:build`, config in tokens.config.json).",
  "manifest": true,
  "collections": [
    {
      "id": "breakpoint",
      "prefix": "breakpoint",
      "preserveCase": true,
      "files": [
        "breakpoint.json"
      ],
      "modeAxes": []
    },
    {
      "id": "metrics",
      "prefix": "",
      "preserveCase": false,
      "files": [
        "metrics.json"
      ],
      "modeAxes": []
    },
    {
      "id": "primitives",
      "prefix": "primitives",
      "preserveCase": false,
      "files": [
        "primitives.json"
      ],
      "modeAxes": [
        {
          "name": "brand",
          "source": "nested",
          "strategy": "selectors",
          "default": "modeBrand1",
          "map": {
            "modeBrand1": ":root",
            "modeBrand2": "[data-brand='brand2'], .brand2",
            "modeBrand3": "[data-brand='brand3'], .brand3"
          }
        }
      ]
    },
    {
      "id": "responsive",
      "prefix": "",
      "preserveCase": false,
      "files": [
        "responsive.json"
      ],
      "modeAxes": [
        {
          "name": "viewport",
          "source": "nested",
          "strategy": "media",
          "default": "modeMobile",
          "map": {
            "modeMobile": ":root"
          }
        }
      ]
    },
    {
      "id": "semantics",
      "prefix": "",
      "preserveCase": false,
      "files": [
        "semantics.json"
      ],
      "modeAxes": [
        {
          "name": "theme",
          "source": "nested",
          "strategy": "selectors",
          "default": "modeLight",
          "map": {
            "modeDark": "[data-theme='dark'], .dark",
            "modeLight": ":root, [data-theme='light'], .light"
          }
        }
      ]
    },
    {
      "id": "transitions",
      "prefix": "",
      "preserveCase": false,
      "files": [
        "transitions.json"
      ],
      "modeAxes": []
    },
    {
      "id": "typography",
      "prefix": "",
      "preserveCase": false,
      "files": [
        "typography.json"
      ],
      "modeAxes": [],
      "fontStacks": {
        "group": "fontFamily",
        "default": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "byFamily": {
          "monospace": [
            "ui-monospace",
            "SFMono-Regular",
            "Menlo",
            "Consolas",
            "monospace"
          ],
          "icon": []
        }
      }
    },
    {
      "id": "styles",
      "prefix": "",
      "preserveCase": false,
      "files": [
        "styles.json"
      ],
      "modeAxes": []
    }
  ],
  "outputs": [
    {
      "id": "css",
      "format": "css-vars",
      "destination": "projects/ui-kit/styles/generated",
      "collections": [
        "metrics",
        "primitives",
        "responsive",
        "semantics",
        "transitions",
        "typography"
      ]
    },
    {
      "id": "scss",
      "format": "scss-vars",
      "destination": "projects/ui-kit/styles/generated",
      "collections": [
        "breakpoint"
      ]
    },
    {
      "id": "styles",
      "format": "composite-styles",
      "destination": "projects/ui-kit/styles/generated",
      "collections": [
        "styles"
      ]
    }
  ]
}
