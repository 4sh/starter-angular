/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "paths": {
      "@app/*": ["./src/app/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      // Must use the package's REAL name (@4sh/ui-kit/*), not a shorthand:
      // ng-packagr only registers a dependency between two entry points when
      // the import literally starts with the package name (see its
      // analyse-sources.transform.js). A bare "ui-kit/ui-icon" specifier is
      // invisible to that analysis, leaving the build order undefined and
      // failing intermittently.
      //
      // Mapped to dist/ui-kit (the packaged output), NOT source: ng-packagr
      // gives each entry point its own isolated tsconfig with a strict
      // `rootDir` scoped to that entry's src/, so a source-to-source mapping
      // across entry points fails with TS6059. `ui-kit:build` therefore runs
      // before the app/Storybook (chained in package.json).
      "@4sh/ui-kit": ["./dist/ui-kit"],
      "@4sh/ui-kit/*": ["./dist/ui-kit/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "strictStandalone": true
  },
  "include": ["src/**/*.ts", "src/**/*.html", "src/**/*.css", "projects/ui-kit/**/*.ts"],
  "references": [
    {
      "path": "./projects/ui-kit/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui-kit/tsconfig.spec.json"
    }
  ]
}
